// Base Prisma configuration
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Auth Provider enum
enum AuthProvider {
  credentials
  google
}

// Video Status enum
enum VideoStatus {
  in_progress
  completed
  failed
}

// User model
model User {
  id                          String                   @id @default(auto()) @map("_id") @db.ObjectId
  provider                    AuthProvider             @default(credentials)
  name                        String
  email                       String                   @unique
  password                    String?
  resetCode                   String?
  resetCodeExpiry             DateTime?
  emailVerificationCode       String?
  emailVerificationExpiry     DateTime?
  pendingEmail                String?
  phone                       String?
  phoneExtension              String?
  company                     String?
  customOrganization          String?
  teamSize                    String?
  website                     String?
  brandColor                  String?
  primaryColor                String?
  secondaryColor              String?
  organizationName            String?
  subdomain                   String?
  advisorName                 String?
  advisorEmail                String?
  advisorPhone                String?
  advisorPhoneExtension       String?
  disclaimer                  String?
  advisorLogoUrl              String?
  complianceEmail             String?
  advisorLink                 String?
  additionalAdvisorLink       String?
  recordkeeperContactLabel    String?
  primaryServiceCategories    String[]
  createdAt                   DateTime                 @default(now())
  plans                       Plan[]
  // resources                Resource[]
  planAnalytic                PlanAnalytic[]
  title                       String?
  headshot                    String?
  backgroundImage             String?
  aiAvatar                    String?
  designations                String[]
  displayAdvisorInfoHeader    Boolean?
  displayAdvisorContactButton Boolean?
  advisorLogo                 String?
  showAdvancedCompliance      Boolean?
  wizardSessions              WizardSession[]
  newClientWizardSessions     NewClientWizardSession[]
  clients                     Client[]
  meetings                    Meeting[]
  webinars                    Webinar[]
  marketingFlyers             MarketingFlyer[]
  headshots                   Headshot[]

  futureContacts    FutureContact[]   @relation("UserFutureContacts")
  meetingCustomTypes MeetingCustomType[]
}

// Plan model
model Plan {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  idIndex Int?   @unique
  userId  String @db.ObjectId

  videoStatus VideoStatus? @default(in_progress)

  clientName           String?
  clientLogo           String?
  videoThemeColor      String?
  videoAvatar          String?
  videoBackgroundMusic String?
  videoBackgroundImage String?
  buildSpanishVideo    Boolean @default(false)

  planType                           String?
  entryDates                         String?
  matchPlan                          String?
  matchSafe                          String?
  nonElective                        String?
  deferrals                          String[]
  investments                        String[]
  advancedInvestments                String[]
  advancedEntryDates                 String[]
  advancedDeferrals                  String[]
  vestingScheduleRadio               String?
  vestingSchedules                   String[]
  employerContribution               String?
  automaticEnrollment                Boolean?
  automaticIncrease                  Boolean?
  customEntryDates                   String?
  customEntryDateType                String?
  customEntryDatesValue              String?
  advancedEntryDatesValue            String?
  mandatoryContribution              Float?
  ageRequirement                     String?
  matchType                          String?
  matchPercentage                    Float?
  safeHarborMatch                    String?
  safeHarborMatchType                String?
  nonElectiveEmployerContributions   Boolean?
  employerProfitSharingContributions Boolean?
  waitingPeriod                      Boolean?
  automaticEnrollmentPercentage      String?
  automaticEnrollmentWaitPeriod      String?
  automaticIncreasePercentage        String?
  automaticIncreaseCap               String?
  waitingPeriodDuration              String?
  waitingPeriodStart                 String?
  waitingPeriodStartDate             String?
  nonElectiveType                    String?
  nonElectivePercentage              String?
  profitSharingType                  String?
  profitSharingPercentage            String?
  useCustomText                      Boolean?
  customText                         String?
  useProfitSharingCustomText         Boolean?
  profitSharingCustomText            String?

  recordkeeper             String?
  recordKeeperName         String?
  recordKeeperPhone           String?
  recordKeeperPhoneExtension  String?
  recordKeeperWebsite         String?
  companyName                 String?
  onlineEnrollment            String?
  isDisplayRecodeKeeper       Boolean?
  title                       String?
  contactName                 String?
  email                       String?
  phoneNumber                 String?
  phoneNumberExtension        String?
  planAdvisor                 String?
  companyContact              String?
  tpa                         String?
  educationalVideos           String?
  providerName                String?
  providerLogo                String?
  website                     String?
  providerPhoneNumber         String?
  providerPhoneNumberExtension String?
  displayAdvisorInfoHeader    Boolean?
  tpaName                     String?
  tpaEmail                    String?
  tpaPhoneNumber              String?
  tpaPhoneNumberExtension     String?
  planDocumentsLinks       String?
  recordKeeperId           String?
  addressCode              String?

  rawData Json?

  pageView      Int @default(0)
  uniqueVisitor Int @default(0)
  videoPlay     Int @default(0)
  videoComplete Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  videos Video[]

  planAnalytic PlanAnalytic[]
  PlanEvent    PlanEvent[]
}

model NewClientContactBuilder {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId           String   @unique @db.ObjectId
  fullName            String
  title               String
  companyName         String
  orgType             String
  customRole          String?
  description         String?
  showOnPortal        Boolean  @default(false)
  enableContactButton Boolean  @default(false)
  email               String?
  phone               String?
  phoneExtension      String?
  meetingLink         String?
  headshot            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session             NewClientWizardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Video model
model Video {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  planId          String?      @db.ObjectId // Optional - for backward compatibility
  clientId        String?      @db.ObjectId // ✅ Primary: Video belongs to Client (Benefits Hub)
  videoUrl        String?
  thumbnail       String?
  title           String
  description     String?
  image           String?
  videoProvider   String       @default("synthesia")
  videoProviderId String?
  videoStatus     VideoStatus? @default(in_progress)
  pagePlacement   String?      // "retirement" | "health-insurance" | "life-insurance" | "wellness-programs" | null
  pageIndex       Int?         // Index/order of video on the page (for sorting)
  data            Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?

  plan   Plan?   @relation(fields: [planId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([planId])
  @@index([clientId])
}

// Analytics models
model PlanAnalytic {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String? @db.ObjectId
  planId String? @db.ObjectId
  key    String  @unique

  date          String
  pageView      Int    @default(0)
  uniqueVisitor Int    @default(0)
  videoPlay     Int    @default(0)
  videoComplete Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])
}

model PlanEvent {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  planId       String? @db.ObjectId
  planStaticId String?
  name         String
  ip           String?

  createdAt DateTime @default(now())

  plan Plan? @relation(fields: [planId], references: [id])
}

// System models
model KeyStorage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  createdAt DateTime @default(now())
}

