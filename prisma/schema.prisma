model NewClientContactBuilder {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId           String   @unique @db.ObjectId
  fullName            String
  title               String
  companyName         String
  orgType             String
  customRole          String?
  description         String?
  showOnPortal        Boolean  @default(false)
  enableContactButton Boolean  @default(false)
  email               String?
  phone               String?
  phoneExtension      String?
  meetingLink         String?
  headshot            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session             NewClientWizardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Video model
model Video {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  planId          String?      @db.ObjectId // Optional - for backward compatibility
  clientId        String?      @db.ObjectId // ✅ Primary: Video belongs to Client (Benefits Hub)
  videoUrl        String?
  thumbnail       String?
  title           String
  description     String?
  image           String?
  videoProvider   String       @default("synthesia")
  videoProviderId String?
  videoStatus     VideoStatus? @default(in_progress)
  pagePlacement   String?      // "retirement" | "health-insurance" | "life-insurance" | "wellness-programs" | null
  pageIndex       Int?         // Index/order of video on the page (for sorting)
  data            Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?

  plan   Plan?   @relation(fields: [planId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([planId])
  @@index([clientId])
}

// Analytics models
model PlanAnalytic {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String? @db.ObjectId
  planId String? @db.ObjectId
  key    String  @unique

  date          String
  pageView      Int    @default(0)
  uniqueVisitor Int    @default(0)
  videoPlay     Int    @default(0)
  videoComplete Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])
}

model PlanEvent {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  planId       String? @db.ObjectId
  planStaticId String?
  name         String
  ip           String?

  createdAt DateTime @default(now())

  plan Plan? @relation(fields: [planId], references: [id])
}

// System models
model KeyStorage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  createdAt DateTime @default(now())
}

