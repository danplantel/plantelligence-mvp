  value String
}

// Wizard Session model - User Onboarding (5 steps)
model WizardSession {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  currentStep Int      @default(1)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  // Wizard Steps - only the 5 steps used in onboarding
  clientProfile      WizardClientProfile?
  teamSize           WizardTeamSize?
  services           WizardServices?
  insuranceLicensing WizardInsuranceLicensing?
  teamMembers        WizardTeamMembers?
  branding           WizardBranding?
  benefitTypes       WizardBenefitTypes?
  userSetup          WizardUserSetup?
  disclaimers        WizardDisclaimers?
  employerScope      WizardEmployerScope?
}

// Wizard Step 1: Client Profile
model WizardClientProfile {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String   @unique @db.ObjectId
  organizationType   String // independent, ria, hybrid, broker, insurance, recordkeeper, other
  customOrganization String?
  organizationName   String? // Organization name from branding
  website            String? // Organization website from branding
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session WizardSession @relation(fields: [sessionId], references: [id])

  @@index([organizationType])
}

// Wizard Step 1B: Team Size
model WizardTeamSize {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @unique @db.ObjectId
  teamSize  String // just_me, 2_5, 6_20, 21_100, 100_plus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session WizardSession @relation(fields: [sessionId], references: [id])

  @@index([teamSize])
}

// Wizard Step 2: Services Provided
model WizardServices {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @unique @db.ObjectId
  services  String[] // retirement, insurance, both
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session WizardSession @relation(fields: [sessionId], references: [id])

  @@index([services])
}

// Wizard Step 3: Insurance Licensing
model WizardInsuranceLicensing {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId       String   @unique @db.ObjectId
  offersInsurance Boolean  @default(false)
  licenseTypes    String[] // life, health, disability, ltc, variable, other
  statesLicensed  String[] // CA, NY, TX, etc.
  licenseNumbers  Json // {state: licenseNumber}
  attestation     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session WizardSession @relation(fields: [sessionId], references: [id])

  @@index([offersInsurance])
  @@index([licenseTypes])
  @@index([statesLicensed])
}

// Wizard Step 4: Team Members
model WizardTeamMembers {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @unique @db.ObjectId
  members   Json // [{name, email, role, isAdmin}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session WizardSession @relation(fields: [sessionId], references: [id])
}

model FutureContact {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  // Legacy fields
  name          String
  email         String
  phone         String
  role          String
  customRole    String?
  headshot      String?
  showOnPortal  Boolean  @default(false)
  enableContactButton Boolean @default(false)
  isPrimary     Boolean  @default(false)
  displayScope  String?  // "futureUse" | "thisPortal"
  // New fields
  benefitsCategory String?
  benefitsCategoryOther String?
  roleOther     String?
  isPrimaryForCategory Boolean @default(false)
  companyName   String?
  companyLogo   String?
  firstName     String?
  lastName      String?
  title         String?
  phoneExtension String?
  website       String?
  userId        String   @db.ObjectId
  user          User     @relation("UserFutureContacts", fields: [userId], references: [id])
  createdAt     DateTime @default(now())
}

// Wizard Step 3: Branding Setup
model WizardBranding {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String   @unique @db.ObjectId
  logo               String? // URL or R2 key
  logoFileName       String? // Original filename
  backgroundImage    String? // URL or R2 key
  backgroundFileName String? // Original filename
  organizationName   String? // Organization name
  website            String? // Organization website
  missionStatement   String? // Optional mission statement
  brandColor         String // HEX color
  primaryColor       String? // Primary HEX color (extracted from logo)
  secondaryColor     String? // Secondary HEX color (extracted from logo)
