// Base Prisma configuration
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Auth Provider enum
enum AuthProvider {
  credentials
  google
}

// Video Status enum
enum VideoStatus {
  in_progress
  completed
  failed
}

// ─────────────────────────────────────────────────────────────────────────────
// Team & Collaborator Access — enums
// See Team_Collaborator_Access_Developer_Spec (1).pdf, ticket T1.
// ─────────────────────────────────────────────────────────────────────────────

// Team Member (internal to the advisor org) or Collaborator (external).
enum TeammatePersonType {
  team_member
  collaborator
}

// Profile lifecycle. A Contact can be upgraded to Invited at any time; the
// profile stays the same.
enum TeammateProfileState {
  contact
  invited
  active
}

// Assignment role. `custom` writes an edited function grid; presets write their
// own default grid (see types/teammate.ts).
enum TeammateAssignmentRole {
  owner
  admin
  editor
  viewer
  contributor
  reviewer
  custom
}

// Category scope on an assignment: every category on the plan, or a picked list.
enum TeammateCategoryScope {
  all
  selected
}

// Partner companies are always Partner/Provider and must never surface in Plan
// Sponsor pickers.
enum TeammateCompanyEntityType {
  partner_provider
}

// User model
model User {
  id                          String                   @id @default(auto()) @map("_id") @db.ObjectId
  provider                    AuthProvider             @default(credentials)
  name                        String
  email                       String                   @unique
  // Forward-looking tenancy anchor. `id` above remains the legacy ownership
  // anchor for all pre-existing queries; see the Organization section at the
  // end of this file.
  organizationId              String?                  @db.ObjectId
  organizationEmail           String?
  password                    String?
  resetCode                   String?
  resetCodeExpiry             DateTime?
  emailVerificationCode       String?
  emailVerificationExpiry     DateTime?
  pendingEmail                String?
  phone                       String?
  phoneExtension              String?
  organizationType            String?
  customOrganization          String?
  teamSize                    String?
  website                     String?
  brandColor                  String?
  primaryColor                String?
  secondaryColor              String?
  organizationName            String?
  advisorName                 String?
  advisorEmail                String?
  advisorPhone                String?
  advisorPhoneExtension       String?
  disclaimer                  String?
  advisorLogoUrl              String?
  complianceEmail             String?
  advisorLink                 String?
  additionalAdvisorLink       String?
  recordkeeperContactLabel    String?
  primaryServiceCategories    String[]
  createdAt                   DateTime                 @default(now())
  plans                       Plan[]
  // resources                Resource[]
  planAnalytic                PlanAnalytic[]
  title                       String?
  headshot                    String?
  backgroundImage             String?
  aiAvatar                    String?
  designations                String[]
  displayAdvisorInfoHeader    Boolean?
  displayAdvisorContactButton Boolean?
  advisorLogo                 String?
  showAdvancedCompliance      Boolean?
  wizardSessions              WizardSession[]
  newClientWizardSessions     NewClientWizardSession[]
  clients                     Client[]
  meetings                    Meeting[]
  webinars                    Webinar[]
  marketingFlyers             MarketingFlyer[]
  marketingAssets             MarketingAsset[]
  headshots                   Headshot[]

  futureContacts    FutureContact[]   @relation("UserFutureContacts")
  meetingCustomTypes MeetingCustomType[]
  tasks             Task[]
}

// Advisor-authored dashboard tasks. System-generated tasks are derived from plan state at
// read time (see lib/dashboard-tasks.ts) and are deliberately not stored here — they have no
// lifecycle of their own and would go stale the moment the underlying plan changed.
model Task {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  title     String
  done      Boolean   @default(false)
  // Optional plan the task relates to. Tasks are per-advisor (they appear on one dashboard);
  // the link adds plan context without splitting them into per-plan lists.
  clientId  String?   @db.ObjectId
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, done])
}

// Plan model
