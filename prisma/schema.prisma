// Base Prisma configuration
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL on Neon. Two URLs on purpose (see plans/postgres-migration.md §P1):
//   url       — the POOLED endpoint the app uses; it carries `pgbouncer=true` so Prisma
//               avoids prepared statements, which PgBouncer cannot support in transaction
//               pooling mode.
//   directUrl — the unpooled endpoint, used only by `prisma migrate`. DDL cannot run
//               through the pooler.
//
// Migrated from MongoDB: `prisma db push` (no migration history) is replaced by versioned
// `prisma migrate`, and `@db.ObjectId` / `@map("_id")` are gone — both existed only because
// MongoDB names its primary key `_id` and stores it as a BSON ObjectId.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Auth Provider enum
enum AuthProvider {
  credentials
  google
}

// Video Status enum
enum VideoStatus {
  in_progress
  completed
  failed
}

