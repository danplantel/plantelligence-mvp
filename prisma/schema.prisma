// Advisor-authored dashboard tasks. System-generated tasks are derived from plan state at
// read time (see lib/dashboard-tasks.ts) and are deliberately not stored here — they have no
// lifecycle of their own and would go stale the moment the underlying plan changed.
//
// The exception is an ASSIGNMENT (plans/comment-task-assignment.md): work an Owner or Admin hands
// to somebody from inside a comment thread. That has to be STORED, for two reasons a derived task
// cannot satisfy — it lands on the ASSIGNEE's dashboard rather than the reader's, and it is work
// being asked for rather than a symptom being shown, so it must not evaporate the moment the plan
// changes under it. When it was assigned from one of the derived tasks the row carries that task's
// kind and category, so it renders with the same icon and destination link and can SUPERSEDE the
// derived row it stands in for.
model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  done      Boolean   @default(false)
  // Optional plan the task relates to. Tasks are per-advisor (they appear on one dashboard);
  // the link adds plan context without splitting them into per-plan lists.
  clientId  String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ── Assignment provenance. All null for a task the viewer wrote for themselves. ──
  //
  // Who handed this over. A plain scalar, like a comment's author id: a deleted login leaves the
  // work standing with a "Removed user" byline rather than taking the task down with it.
  assignedByUserId String?
  // The conversation it was assigned in, and the message that announced it. Scalars on purpose —
  // the task outlives a deleted thread, because the work is not owned by the discussion.
  sourceThreadId  String?
  sourceMessageId String?
  // The DERIVED task this stands in for, when it was assigned from one. `(clientId, derivedKind,
  // benefitCategory)` is exactly the identity of a derived row — its id is
  // `system-{kind}-{planId}-{category}` — which is what lets the dashboard show ONE row per unit
  // of work instead of two.
  derivedKind     String?
  benefitCategory String?
  // The needs-attention HEADING the work came from, e.g. "Incomplete benefit: Group Life", when it was
  // assigned from one of the issues under it. Carried because the heading is not derivable from the
  // kind and category — "No disclaimers configured" is a heading, "Missing disclaimers" is the kind —
  // and a reader looking at the card needs to know which problem the inner task belongs to.
  derivedGroupLabel String?
  // Reserved. No UI yet; a due date is the natural next addition to the assign dialog.
  dueAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, done])
  @@index([assignedByUserId])
  @@index([sourceThreadId])
  // The de-duplication read: "does this reader hold an assignment covering this derived row?"
  @@index([userId, clientId, derivedKind])
}

// In-app notifications (persisted, per-user read/unread).
//
// The header bell's other two sources (meeting reminders, expiring documents) are
// DERIVED from plan state on each fetch and dismissed client-side. These are the
// opposite: written once, addressed to a specific User, and carrying their own read
// state, so a notification survives a reload and is per-person rather than
// per-device. `userId` is a real relation with `onDelete: Cascade` so deleting the
// account takes its notifications with it — the teammate models keep plain scalars
// only because they predate real relations.
model Notification {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Machine-readable kind (e.g. "team_member_accepted") so the UI can pick an icon
  // and a section without parsing prose.
  type  String
  title String
  body  String?
  // Where clicking the row goes; null when the notification is informational only.
  href  String?

  // The person the notification is ABOUT (a TeammateProfile id), when there is one.
  profileId   String?
  // The User who caused it, when there is a human actor.
  actorUserId String?

  // NULL means unread. A timestamp rather than a boolean, so WHEN it was read survives.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// One browser's web-push endpoint.
///
/// A subscription belongs to the BROWSER, not to an installed app: the dashboard and every plan portal
/// share one origin and one service worker (scope "/"), so a phone that installs two different plan
/// portals still holds exactly ONE subscription. `surface` records where the reader opted in so the
/// sender can address the right audience — it does not describe two delivery channels, because there
/// is only one. See plans/web-push-notifications.md.
///
/// `endpoint` is the identity AND a bearer capability on the push service: whoever holds it can push
/// to that browser, so it is never returned to a client that did not present it. It is @unique so a
/// browser that re-subscribes upserts instead of accumulating dead rows.
///
/// `userId` is deliberately rebound on every subscribe: a shared browser can change hands, and a
/// notification addressed to the previous user of that device would be a data-leak-shaped bug.
model PushSubscription {
  id String @id @default(cuid())

  /// The push service URL. Unique — this is the device.
  endpoint String @unique
  /// Client public key (base64url) from the payload-encryption handshake.
  p256dh String
  /// Client auth secret (base64url), the other half of that handshake.
  auth   String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "portal" | "dashboard". Text rather than an enum so a new surface needs no migration.
  surface String @default("dashboard")
  /// The plan a portal opt-in came from. Null for the dashboard, and deliberately a plain scalar
  /// (like the teammate models) rather than a relation — nothing here needs client-level cascade.
  clientId String?

  /// Per-type opt-outs, e.g. { "direct_message": false }. NULL means every type is on, which is the
  /// state of every row written before preferences existed.
  preferences Json?

  userAgent String?
  createdAt DateTime @default(now())
  /// Bumped on every successful send, so a healthy endpoint is distinguishable from an untested one.
  lastSuccessAt DateTime?
  /// Consecutive failures. Rows are pruned on 404/410 well before this matters; the counter exists so
  /// a stuck endpoint is diagnosable instead of invisible.
  failureCount Int @default(0)

  @@index([userId])
  @@index([surface, clientId])
}

