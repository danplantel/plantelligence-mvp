// Client model - stores completed client data
model Client {
  id     String @id @default(cuid())
  userId String
  // Additive tenancy anchor for the Team & Collaborator Access feature. `userId`
  // (the owning advisor) stays authoritative for existing queries; new code
  // scopes by organizationId through lib/organization.ts.
  organizationId String?

  // URL-friendly identifier (e.g. "acme-corp").
  //
  // Deliberately NOT @unique. On MongoDB a unique index counts every null as a
  // real key, so as soon as a second plan has no slug the build fails with
  // `dup key: { slug: null }` and aborts the entire `prisma db push`. Global slug
  // uniqueness is guaranteed by `PortalSlug.slug` (@unique, non-null), which
  // registers every current AND retired slug; this column is the legacy mirror,
  // and is additionally guarded by a partial unique index applied via
  // scripts/repair/apply-partial-unique-indexes.ts.
  slug   String?

  // Company Information
  companyName     String
  // Name-change tracking for the dashboard activity feed. `null` until the plan is
  // renamed; `updatedAt` cannot serve this purpose because every edit touches it.
  previousName    String?
  nameUpdatedAt   DateTime?
  companyWebsite  String?
  companyLogo     String? // Base64 or URL
  companyLogoCropData Json? // Crop metadata incl. originalImage for re-editing in modal
  logoFileName    String?
  brandColor      String  @default("#1F3A60")
  secondaryColor  String  @default("#6B7280")
  // Portal typography theme: "classic" | "modern" | "editorial" | "contemporary"
  // (see lib/typography-themes.ts). Null/unknown resolves to "classic", so
  // existing plans render the default theme without a backfill.
  typographyTheme String?
  missionHeadline String?
  missionBody     String?
  appointmentLink String?
  
  // Benefits / Employee Portal Data
  employeePortalPreview Json? // Stores benefits title, description, and other portal settings
  categoryPortalVisibility Json? // { Retirement: true, Group Life: true, Group Health: true, Other: true } - Show/Hide per category in portal only
  /// Employee Resources hub (TF-6). OFF by default: the fifth location is opt-in per plan,
  /// is not a benefit category, and therefore never counts toward the 1–4 limit.
  employeeResourcesEnabled Boolean @default(false)

  /// Life Events (TF-8) — one row per seeded checklist, plan-scoped.
  lifeEvents LifeEvent[]

  heroTitle       String? // Hero title for portal header
  heroDescription String? // Hero description for portal header
  heroOverlayOpacity              Float? // Overlay opacity (0-1)
  heroBackgroundOpacity           Float? // Background image opacity (0-1)
  heroContainerOpacity            Float? // Container (text box) opacity (0-1) - DEPRECATED: use heroContainerBackgroundOpacity and heroContainerBlockOpacity
  heroContainerBackgroundOpacity  Float? // Container background opacity (0-1)
  heroContainerBlockOpacity       Float? // Container block opacity (0-1)
  heroCompanyNameColor            String? // Company name color: "yellow" or "default"
  heroContainerInverted           Boolean? @default(false) // Invert container colors (white container with dark text)
  heroBackgroundInverted          Boolean? @default(false) // Invert background overlay colors (white overlay)
  heroUseGradient                 Boolean? @default(false) // Use gradient from top (transparent) to bottom (opaque)
  desktopHeroBackgroundPosition   Json? // { x: number, y: number } — desktop hero background focal point (percentage)
  mobileHeroBackgroundPosition    Json? // { x: number, y: number } — mobile hero background focal point (percentage)
  // The image the welcome banner's circular portrait shows (R2 key or URL).
  // Null means "use the category's key contact headshot", which is the default —
  // the advisor only sets this when they want a different picture.
  heroPortraitImage String?

  // Brand Images
  backgroundImg          String? // Base64 or URL (header/hero image)
  backgroundImgName      String?
  thumbnailImg           String? // Base64 or URL (square thumbnail)
  thumbnailImgName       String?
  secondaryBannerImg     String? // Base64 or URL (secondary banner)
  secondaryBannerImgName String?
  faviconImg             String? // Base64 or URL (favicon/icon)
  faviconImgName         String?

  brandImagesCropData    Json?

  disclaimers Json? // DisclaimersData object: { disclaimers: [], byCategory: { Retirement?: Disclaimer, "Group Life"?: Disclaimer, "Group Health"?: Disclaimer, Other?: Disclaimer }, disclosuresText: string, useDefaultDisclosures: boolean } — each portal category can have its own footer disclaimer (see types/new-client-wizard.ts)

  // Key Contacts
  keyContacts Json // [{name, role, customRole, email, phone, headshot, headshotFileName, bio, displayEmail, displayPhone, contactButton, contactButtonType, contactUrl}]

  // Recordkeeper (for retirement services)
  recordkeeper String? // Recordkeeper name for retirement services

  // Documents are now stored in separate Document table

  // Status
  status String @default("Active") // Draft, Active, Archived

  // Type
  type String @default("client") // client, prospect

  // Wizard step tracking
  currentStep Int @default(1) // Current step in the wizard when saved as draft

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  documents Document[]
  webinars  Webinar[]
  videos    Video[]    // ✅ Videos belong to Client (Benefits Hub)
  meetings  Meeting[]
  marketingFlyers MarketingFlyer[]
  marketingAssets MarketingAsset[]

  @@index([companyName])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  benefits Benefit[]
  commentThreads CommentThread[]
  // Topic framework (TF-1): placements and Quick Answers groups are plan-scoped.
  topicPlacements TopicPlacement[]
  accordionGroups AccordionGroup[]
}

// Benefit model — one row per (clientId, category)
model Benefit {
  id          String   @id @default(cuid())
  clientId    String
  category    String   // "Retirement" | "Group Health" | "Group Life" | "Company / Plan Sponsor"

  // Core
  title            String
  shortDescription String?

  // Journey Section
  journeyHeader   String?
  journeySubtitle String?
  journeyBodyText String?

  // Plan Video (raw R2 key or external URL)
  planVideo         String?
  planVideoFileName String?
  // Content label shown beside the runtime: "Advisor Intro" | "This benefit" | "Our Services".
  planVideoLabel     String?
  // Poster image: an uploaded image, a frame captured from the video, or an external URL.
  planVideoThumbnail String?
  // Image shown in the journey section INSTEAD of a video — an upload or a gallery
  // pick from the editor's "Default Image" card. Null means the category's stock
  // image is used (see lib/benefits-video-fallback.ts).
  planVideoFallbackImage String?
  // Editor's "Show on page" toggle: false hides the whole video section on the
  // portal. Defaults to true so existing rows keep their video.
  planVideoVisible Boolean @default(true)

  // Branding
  partnerLogo     String?
  backgroundImage String?
  innerHeaderImage String?

  // Landing page "Benefits at a Glance" card — dedicated image + body copy so the
  // card can differ from the hub's inner header and intro message.
  landingCardImage String?
  landingCardBody  String?

  // Help Cards
  helpCards Json?

  // Insurance / Portal Materials
  insurancePlanId               String?
  insuranceLoginUrl             String?
  insuranceBackgroundImage      String?
  insuranceContainerBlockOpacity Float?

  // FAQs & Support Contacts
  faqs            Json?
  supportContacts Json?
  // Provider / recordkeeper that administers this benefit for this category
  // (e.g. Voya, Empower, UnitedHealthcare). See types/benefit.ts → ProviderContact.
  // Rendered beside the account-access block; the provider's logo is `partnerLogo`.
  providerContact Json?

  // Closing & Signature
  signatureMode           String?
  customClosing           String?
  customSignatureName     String?
  customSignatureCompany  String?
  customClosingBold             Boolean?
  customClosingItalic           Boolean?
  customSignatureNameBold       Boolean?
  customSignatureNameItalic     Boolean?
  customSignatureCompanyBold    Boolean?
  customSignatureCompanyItalic  Boolean?

  // Hero Overlay Settings (per-benefit, overrides client-level)
  heroBackgroundOpacity    Float?
  heroContainerBlockOpacity Float?
  heroContainerInverted     Boolean?
  heroBackgroundInverted    Boolean?
  heroUseGradient           Boolean?
  desktopHeroBackgroundPosition Json?
  mobileHeroBackgroundPosition  Json?

  // Visibility
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, category])
  @@index([clientId])
  @@index([category])
}

// ── Topic framework (TF-1) ──────────────────────────────────────────────────
//
// Three objects, exactly as the handoff describes them:
//
//   Topic          the CONTENT, written once and shared by every plan
//   TopicPlacement puts one topic on ONE plan, in ONE location, with its display
//                  mode, order and per-plan overrides
//   AccordionGroup names the Quick Answers group a placement sits in
//
// Additive on purpose: `Benefit.helpCards` and `Benefit.faqs` stay the live source
// until the read path is switched per plan (see lib/topics/read-source.ts and
// plans/benefits-topic-framework-tf1-tf4.md). Nothing here reads or writes them.

enum TopicScope {
  system
  org
}

enum TopicStatus {
  active
  archived
}

/// `quick_answers` is the handoff's "accordion" mode — the topic is listed under
/// Quick Answers instead of rendering as a Featured card.
enum TopicDisplayMode {
  featured
  quick_answers
  hidden
}

/// A location is a hub topics can render on. `employee_resources` is reserved for
/// TF-6: it is never seeded and never rendered in this build, but reserving the
/// value now means adding that hub needs no migration.
enum TopicLocation {
  retirement
  group_health
  group_life
  custom
  employee_resources
}

/// One reusable topic in the library.
model Topic {
  id     String     @id @default(cuid())
  scope  TopicScope @default(system)
  /// Null for system topics, required for org-authored ones.
  organizationId String?
  /// Stable identifier, namespaced so ONE unique constraint covers both scopes:
  /// `sys.rollovers-distributions` or `org.<organizationId>.<slug>`.
  slug String @unique

  title   String
  summary String?
  /// An icon key from the portal icon set (see components/icons.tsx).
  iconKey String?
  /// Card image — an R2 key or an external URL.
  imageKey String?
  /// Ordered content blocks for the answer panel (types/topic.ts → TopicBodyBlock).
  bodyBlocks Json?
  tags       String[] @default([])
  /// Locations this topic belongs to by default, used when seeding a plan so a
  /// topic's home categories travel with it instead of living in seed code.
  defaultLocations TopicLocation[] @default([])
  /// Cross-category Action Hub (TF-5). Present now so seeding needs no migration.
  isActionHub Boolean @default(false)
  /// Default conversion CTA: { label, actionType, destination } (TF-11).
  defaultCta Json?
  status     TopicStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements TopicPlacement[]

  @@index([scope])
  @@index([organizationId])
  @@index([status])
}

/// One topic, placed on one plan, in one location.
///
/// The `clientId + topicId + location` unique is what makes seeding idempotent:
/// re-running the seeder updates a plan's placement instead of duplicating it, and
/// the same topic can still appear in two locations of the same plan.
model TopicPlacement {
  id       String @id @default(cuid())
  clientId String
  topicId  String
  location TopicLocation

  displayMode TopicDisplayMode @default(featured)
  /// The Quick Answers group. Null for a Featured or Hidden placement.
  groupId String?
  /// Order within the zone: among Featured cards, or within the group's questions.
  sortOrder Int @default(0)
  /// Per-plan overrides of the topic's copy / CTA, merged by the effective-topic
  /// resolver. Never written to the Topic itself, so one plan cannot edit another.
  overrides Json?
  /// This location's row in the Action Hub panel (TF-5).
  actionHubLink Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  topic  Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  group  AccordionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Life Event checklist steps that point at this placement (TF-8).
  lifeEventSteps LifeEventStep[]

  @@unique([clientId, topicId, location])
  @@index([clientId, location, sortOrder])
  @@index([topicId])
  @@index([groupId])
}

/// One Life Event checklist for a plan (TF-8, handoff §7a/§14).
///
/// A Life Event is NOT content: it is an ordered list of existing placements. The row
/// keeps the template's key and its deadline window; changing the plan's own window is
/// a field edit, not a new checklist.
model LifeEvent {
  id       String @id @default(cuid())
  clientId String
  /// One of the eight template keys: having_a_baby, moving, …
  key      String
  title    String
  sortOrder Int   @default(0)
  /// Null means "no deadline banner". A plan may override the template's default.
  deadlineDays Int?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  steps  LifeEventStep[]

  @@unique([clientId, key])
  @@index([clientId, sortOrder])
}

/// One checklist line. `placementId` is the whole point: the step IS a placement, so
/// it can never point at content this plan does not have.
///
/// `onDelete: SetNull` on the placement is deliberate — deleting a placement must not
/// silently delete the advisor's checklist row; the resolver drops a step whose
/// placement is gone, and the builder can show it as "needs a topic" instead.
model LifeEventStep {
  id            String  @id @default(cuid())
  lifeEventId   String
  placementId   String?
  sortOrder     Int     @default(0)
  /// The checklist's own wording, when the topic's title is too long or too vague.
  labelOverride String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lifeEvent LifeEvent      @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)
  placement TopicPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([lifeEventId, sortOrder])
  @@index([placementId])
}

/// A named Quick Answers group for one plan + location. Advisors rename, add and
/// reorder these; the placement's `groupId` says which one a question sits in.
model AccordionGroup {
  id       String        @id @default(cuid())
  clientId String
  location TopicLocation
  name     String
  sortOrder Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  placements TopicPlacement[]

  @@unique([clientId, location, name])
  @@index([clientId, location, sortOrder])
}

// A comment thread anchored to a section, or a selected text range, of a Plan
// (Client) or a Benefit (Client + category).
//
// Deliberately NOT keyed to a `Benefit.id`: a Benefit row is replaced/re-saved by
// category over the app's life, so `clientId + benefitCategory` is the stable
// identity a thread can survive. `targetType` tells the two surfaces apart.
//
// The anchor is SEMANTIC, never a DOM coordinate: `sectionKey` is a stable key the
// region renders (e.g. "company", "disclaimers", "benefit:faqs"), and a text anchor
// adds the field plus the selection offsets and the selected `quote`. See
// plans/plan-benefit-comments.md.
model CommentThread {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  // "plan" | "benefit".
  targetType String
  // Normalized category key when `targetType` is "benefit"; null for a plan thread.
  benefitCategory String?

  // "section" | "text".
  anchorKind String
  sectionKey String
  // Text anchors only: the field the range lives in, its offsets, and the selected text.
  fieldKey   String?
  rangeStart Int?
  rangeEnd   Int?
  quote      String?

  resolvedAt       DateTime?
  resolvedByUserId String?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Real relation with cascade: deleting a plan takes its threads with it. The
  // author ids stay plain scalars so a deleted login does not erase the history —
  // the UI renders a "Removed user" fallback instead.
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages CommentMessage[]
  typing   CommentTyping[]

  @@index([organizationId, clientId])
  @@index([clientId, benefitCategory])
  @@index([clientId, resolvedAt])
}

// One message in a `CommentThread`. The opening post is the thread's first message.
model CommentMessage {
  id           String    @id @default(cuid())
  threadId     String
  authorUserId String
  body         String
  // "comment" | "task_assignment".
  //
  // A KIND rather than a prose line, so an assignment renders as a card (title, assignee, live
  // state) instead of a sentence a reader has to parse — and so nothing downstream has to
  // pattern-match English to find one. `body` still carries a plain-text fallback, which is what
  // the notification and any consumer that does not know what a card is will show.
  kind String @default("comment")
  // The Task this message announces or reports on, when `kind` is "task_assignment". A plain
  // scalar, like the author id: the message outlives a deleted login, and the task is what the
  // dashboard reads.
  taskId String?
  // Mentioned User ids, parsed at write time so the notification pass does not re-parse.
  mentions  String[]  @default([])
  // Files attached to this message: [{ key, name, type, size }]. Each `key` lives under
  // `org/{ownerUserId}/plans/{clientId}/comments/…`, so the existing /api/r2/object proxy
  // authorizes reads against the caller's plan assignment with no extra plumbing.
  attachments Json?
  // Soft delete keeps a thread readable after a message is withdrawn.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  thread CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  // "Which card reports on this task?" — the read that keeps a card's state honest as the task
  // behind it is completed or withdrawn.
  @@index([taskId])
}

// "Currently typing" on a comments surface.
//
// A ROW PER (scope, person) rather than a column on the thread. That is the structural difference
// from `DirectThread`, whose `aTypingAt`/`bTypingAt` fit on the row because a DM has exactly two
// participants: on a comment thread ANYONE who can comment on the surface can take part, so the
// number of people who might be typing at once is unbounded and has no fixed pair to lay out.
//
// Expiry works exactly as it does for a DM — `pingedAt` is a timestamp and the reader applies
// `COMMENT_TYPING_TTL_MS` — so the signal decays with no "stopped typing" event, and a closed laptop
// cannot leave a name stuck on a card. Rows are tiny and are pruned opportunistically whenever a
// surface is read, so the table stays proportional to who is typing right now rather than to the
// history of who ever did.
//
// `userId` is a plain scalar, like `CommentMessage.authorUserId` and deliberately unlike the DM's
// cascading `User` FKs: a comment thread outlives a deleted login (the history stays readable), so a
// typing row must simply disappear rather than take anything with it.
model CommentTyping {
  id String @id @default(cuid())

  // WHAT is being typed into, as one always-present key:
  //
  //   `thread:{threadId}`                               — a reply to an existing thread
  //   `surface:{clientId}:{targetType}:{category}`      — the rail's persistent composer, which is
  //                                                        composing a NEW thread and therefore has
  //                                                        no thread to attribute the signal to
  //
  // Non-null on purpose, so ONE unique index covers both cases. Two nullable columns would have
  // needed TWO uniques and would have leaned on PostgreSQL treating NULLs as distinct in a unique
  // index — a footnote rather than a guarantee, and exactly the kind of thing that quietly stops
  // being true one migration later.
  scopeKey String

  // Set only for a thread-scoped row, purely to carry the cascade. Nullable because a surface row
  // has no thread to point at — which is the entire reason the surface case exists.
  threadId String?
  userId   String
  pingedAt DateTime @default(now())

  thread CommentThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, userId])
  @@index([scopeKey, pingedAt])
}

// A private 1:1 conversation between two logins in one organization.
//
// Unlike a `CommentThread`, this is deliberately NOT keyed to a plan: a DM is between two
// people, and it must survive any plan being renamed, re-scoped or deleted. Nothing about
// reading one depends on plan access — the only gate is participation.
//
// `userAId`/`userBId` are stored in a CANONICAL order (`userAId < userBId`), and that order is
// ENFORCED by a CHECK constraint added in the migration — Prisma cannot express a CHECK, so the
// constraint lives in `20261013182800_direct_thread_pair_order/migration.sql` and nowhere here.
// It is load-bearing rather than decorative: a unique index on `(organizationId, userAId, userBId)`
// does NOT stop a swapped insert, which would leave two conversations for one pair (measured, not
// assumed — see that migration's comment). With the order pinned, the compound unique below means
// exactly what it says: one thread per pair, so opening a conversation is an upsert.
//
// `organizationId` is part of that key because one login can back seats in several organizations
// (T1 Part B item 5) — the same two people in two organizations are two conversations, not one
// thread with an ambiguous scope.
//
// Read state is ONE WATERMARK PER PARTICIPANT rather than a row per message: unread is then a
// single `createdAt > myWatermark` count, "mark read" is one update, and the rail gets its
// "New messages" divider for free.
model DirectThread {
  id             String @id @default(cuid())
  // Plain scalar, like every teammate row: this layer's FKs stop at `User`. The organization
  // sweep that makes that safe is `deleteOrganizationTeammateData`.
  organizationId String

  // Canonical pair — `userAId < userBId`, lexicographically.
  userAId String
  userBId String

  // NULL means "never opened", which is also what makes every message unread.
  aReadAt DateTime?
  bReadAt DateTime?

  // "Currently typing" — one self-expiring timestamp per participant, mirroring the read
  // watermarks above.
  //
  // A TIMESTAMP and not a boolean, so the signal decays on its own: nobody has to send a "stopped
  // typing" event, a closed laptop cannot leave the dots animating forever, and a dropped request
  // cannot strand the state. The reader treats anything older than TYPING_TTL_MS as "not typing".
  //
  // On the row rather than in process memory because the app is deployed across processes: an
  // in-memory map would be per-instance, so two participants routed to different instances would
  // simply never see each other type.
  aTypingAt DateTime?
  bTypingAt DateTime?

  // Denormalised so the conversation list can sort without touching `DirectMessage`.
  lastMessageAt       DateTime @default(now())
  lastMessageByUserId String?
  // The newest message's text, flattened and truncated for the list row — denormalised for the
  // same reason `lastMessageAt` is. Reading it from `DirectMessage` would be either an unbounded
  // "every message in my threads" read or one small query per conversation on every 10-second
  // poll; this way the inbox touches one table. A withdrawn message stores its placeholder text,
  // and withdrawing the NEWEST message recomputes this.
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Real relations WITH cascade — deliberately the OPPOSITE of the comment models above, where
  // the author ids are plain scalars so a deleted login leaves the history readable. A private
  // conversation must not outlive either participant: deleting an account removes the thread and
  // its messages, and there is nobody left who should be able to read them.
  userA User @relation("DirectThreadParticipantA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("DirectThreadParticipantB", fields: [userBId], references: [id], onDelete: Cascade)

  messages DirectMessage[]

  @@unique([organizationId, userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

// One message in a `DirectThread`.
model DirectMessage {
  id           String       @id @default(cuid())
  threadId     String
  thread       DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String
  // Empty when the message carries only files, exactly as a comment may. `assertBody` refuses
  // the combination of an empty body and no attachments.
  body String
  // [{ key, name, type, size }], like a comment's — but under `org/{organizationId}/messages/…`,
  // authorized by THREAD PARTICIPATION rather than plan access. See lib/messages.
  attachments Json?
  // Soft delete: the row stays so the thread reads as a conversation, and the message renders as
  // a withdrawn placeholder. Author-only — there is no moderator on a private thread.
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// Meeting model
model Meeting {
  id           String   @id @default(cuid())
  userId       String?
  clientId     String? // Plan (Client) — set for Benefits Hub plan-scoped meetings
  meeting      String // Meeting name/title
  meetingType  String // Open Enrollment, Client Meeting, Training, etc. (plan meetings: 4 hub types)
  client       String // Client name (denormalized; legacy meetings without clientId)
  date         DateTime // Meeting date
  time         String // Meeting time
  timezone     String? // Meeting timezone (IANA preferred for plan meetings)
  duration     String // Meeting duration
  format       String // Virtual, In-Person, Hybrid
  platform     String? // Platform for virtual meetings (Zoom, Teams, Google Meet, Phone)
  meetingLink  String? // Meeting URL/link
  maxAttendees Int? // Maximum number of attendees
  attendees    Int      @default(0) // Current number of attendees
  description  String? // Meeting description
  status       String   @default("Scheduled") // Scheduled, Completed, Cancelled

  // Address fields for In-Person meetings
  address String? // Meeting address
  city    String? // City
  state   String? // State
  zip     String? // ZIP code

  language              String? // Meeting language (English, Spanish)
  benefitsCategory      String? // Retirement, Group Health, Group Life, Other
  customBenefitsCategory String? // Custom benefits category when Other is selected

  // Plan / Benefits Hub (3b.1)
  hubLocation      String? // Single location: join link or physical address
  displayOnPortal  Boolean  @default(true)
  archived         Boolean  @default(false)
  registrationUrl  String?
  replayUrl        String?
  startAtUtc       DateTime? // Sort/compare instant; derived from date + time + timezone when possible

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?   @relation(fields: [userId], references: [id])
  clientRecord Client? @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([client])
  @@index([date])
  @@index([status])
  @@index([meetingType])
  @@index([archived])
  @@index([displayOnPortal])
  @@index([startAtUtc])
}

model MeetingCustomType {
  id          String @id @default(cuid())
  value       String
  label       String
  description String
  userId      String
  user        User   @relation(fields: [userId], references: [id])
}

// Webinar model for Webinars & Replays
model Webinar {
  id           String   @id @default(cuid())
  userId       String
  clientId     String // Reference to Client (Plan)
  clientName   String   // Client company name (denormalized for easier queries)
  webinarTitle String   // Webinar title
  description  String?  // Optional description shown alongside the replay
  thumbnail    String?  // Base64 data URL for the replay card image (uploaded or a captured video frame)
  // Benefit category the video belongs to: Retirement, Health, Life, Other or All.
  benefitsCategory String?
  // Portal pages this video is published on: an array of placement keys
  // ("news-events", "retirement", …). JSON rather than a scalar list so rows
  // saved before this field existed read as null and can fall back to the default.
  placements   Json?
  // Length of videoFileUrl. Stored so list queries can sort by size without
  // reading the multi-MB base64 payload (see the webinars list endpoint).
  videoSize    Int?
  // Runtime printed on the card's bottom-right badge (`m:ss`). Measured when the
  // video is uploaded, so a list read carries it without touching the payload.
  duration     String?
  eventDate    DateTime // Event date
  sourceType   Json     // { upload: boolean, url: boolean }
  videoFileUrl String?  // URL/path if uploaded file
  videoUrl     String?  // URL if external link (YouTube/Vimeo)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([eventDate])
  @@index([createdAt])
}

// Document model
model Document {
  id              String    @id @default(cuid())
  title           String // Document title
  fileName        String // Original file name
  fileUrl         String // Legacy: base64 data URL. When storageKey is set, may be empty; file is served from R2 via signed URL.
  storageKey      String?   // R2 object key (org/.../documents/{category}/...) when file is in R2
  type            String    @default("Document") // Document type: SPD, SBC, or Document
  shortDescription String? // Optional short description for the document
  language        String?  @default("EN") // Document language: EN or ES
  clientId        String // Reference to Client
  category           String?  // Document category: Retirement, Group Health, etc. (BenefitsCategory / portal mapping)
  categorySuggested  String?  // AI- or auto-detected suggested category (spec: aiSuggestedCategory)
  categoryConfidence Int?      // 0–100 confidence for categorySuggested (spec: aiConfidence)
  uploadedAt         DateTime  @default(now())
  expirationDate     DateTime? // Optional expiration date for the document
  sortOrder          Int?      // Advisor-set display order; lower sorts first (nulls = last)
  showQrCode         Boolean   @default(true) // Whether to expose QR / quick-access affordances for this document
  archivedAt         DateTime? // Soft-archive: null = active; set = hidden from Hub default lists

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([uploadedAt])
  @@index([language])
  @@index([expirationDate])
  @@index([clientId, category])
  @@index([clientId, archivedAt])
}

// Plan-scoped marketing flyers (Benefits Hub QR + co-brand snapshot + R2 assets)
model MarketingFlyer {
  id              String    @id @default(cuid())
  clientId        String
  userId          String
  mode            String // hub_promo_general | action_beneficiaries | meetings_invite | ...
  modeOptions     Json? // { category?, openEnrollmentLabel?, meetingTitle?, ... }
  headline        String
  body            String
  cta             String
  hubUrlSnapshot  String // Absolute URL encoded in QR at generation time
  brandSnapshot   Json // sponsor + organization branding at render time
  pdfStorageKey   String
  pngStorageKey   String
  aiModel         String?
  aiPromptVersion String?
  generatedCopyAt DateTime?
  title           String? // Optional library title (defaults to headline in UI)
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([clientId, archivedAt])
  @@index([createdAt])
}

// Unified marketing assets (flyer, portal-notice, pop-up, news-post)
model MarketingAsset {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  type      String   // "flyer" | "portal-notice" | "pop-up" | "news-post"
  status    String   @default("Draft") // Draft | Ready for Review | Published | Scheduled | Hidden | Archived
  headline  String
  body      String   @default("")
  ctaText   String   @default("")
  startDate String?
  endDate   String?
  bgColor   String   @default("#23919c")
  data      Json?    // Type-specific payload: { subtitle?, meetingTime?, noticeType?, showEveryVisit?, category?, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([clientId, type])
  @@index([clientId, status])
}

// Headshot model for processed user headshots
model Headshot {
  id          String   @id @default(cuid())
  userId      String // Reference to User
  originalUrl String // Original image URL/base64
  square400   String // 400x400 square variant
  square800   String // 800x800 square variant (retina)
  circle400   String // 400x400 circle variant with transparent background
  circle800   String // 800x800 circle variant (retina)
  avatar64    String // 64x64 small avatar
  cropData    Json // Crop coordinates and settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// Global portal-slug registry.
//
// Holds a plan's CURRENT slug and every historical (retired) slug so old
// QR/printed/shared links keep resolving. `slug` is globally @unique across
// BOTH current and retired rows — that single constraint is what makes a
// retired slug permanently reserved (another advisor cannot claim it), which
// prevents old links from silently pointing at a different company.
//
// Renaming demotes the old row (isCurrent = false → it becomes an "alias") and
// inserts/promotes the new one. Aliases are never mutated or auto-deleted; a
// slug leaves the namespace only via an explicit release (row deleted).
model PortalSlug {
  id         String    @id @default(cuid())
  slug       String    @unique
  clientId   String
  isCurrent  Boolean   @default(true)
  // When the row was demoted to an alias (null while it is the current slug).
  retiredAt  DateTime?
  // The slug that replaced this one (traceability; null when current).
  replacedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId])
  @@index([clientId, isCurrent])
}

// ─────────────────────────────────────────────────────────────────────────────
// Team & Collaborator Access (spec: Team_Collaborator_Access_Developer_Spec)
//
// T1 introduces a real Organization entity. `userId` (the owning User) remains
// the anchor for every pre-existing query; `organizationId` is the forward
// looking anchor that all teammate reads and writes are scoped by. The two are
// kept in sync by scripts/teammates/backfill-organizations.ts and by the signup
// path in lib/auth-options.ts.
//
// Why plain scalar `organizationId` instead of an `@relation`: the MongoDB
// connector requires both sides of a relation to be declared and pulls in
// referential-action semantics we do not want for an additive migration. Every
// teammate collection is scoped by an explicit organizationId filter instead.
// ─────────────────────────────────────────────────────────────────────────────

// Organization — the tenancy root for the Team & Collaborator Access feature.
// One per advisor User today (ownerUserId), created at signup or by backfill.
model Organization {
  id                String   @id @default(cuid())
  name              String
  ownerUserId       String
  // The user id whose R2 segment this organization's OWN-LEVEL objects were written under:
  // `org/{storageAnchorUserId}/uploads/{subPath}/…` — the advisor headshot, the advisor logo.
  //
  // NULL for every organization that has never been handed over, which is all of them today.
  // It exists because `ownerUserId` MOVES and the segment does not: `resolveObjectAccess`
  // authorizes an org-level key by resolving its segment back to an organization
  // (`findFirst({ where: { ownerUserId: orgSegment } })`), so the moment a handover changed the
  // owner, every object already written under the previous owner's id became unresolvable — the
  // advisor's own logo would 403 for the whole team that had just been given the organization.
  //
  // A re-key of every stored object was the alternative and is why this column exists instead:
  // this is a record of a FACT (where the bytes are), so it is written once on handover and never
  // rewritten. See `transferOrganizationOwnership` in lib/teammates/ownership.server.ts.
  storageAnchorUserId String?
  organizationEmail String?
  // T3 seat metering. Both are placeholders until tier pricing is final (spec
  // Open Decisions): a null `seatsIncluded` falls back to DEFAULT_SEATS_INCLUDED,
  // and a confirmed over-limit add raises `seatsIncluded` by one rather than
  // hard-blocking.
  seatsIncluded     Int?
  planTier          String?
  // Firm profile, mirrored from the owner's User row by `syncOrganizationIdentity`
  // (lib/organization.ts) alongside `name` and `organizationEmail`.
  //
  // These deliberately live here and NOT in `wizardSessions[0].clientProfile` /
  // `.teamSize`, which is where Settings -> Organization used to save them. Those tables
  // are the onboarding wizard's own draft storage and are scoped to ONE advisor, so an
  // organization-level setting stored there was invisible to the organization (and to a
  // second admin) and left `User.organizationType` stale. The wizard keeps using its
  // session tables for its own flow; these columns are the organization's copy.
  organizationType   String?
  customOrganization String?
  teamSize           String?
  // Owner branding mirrored from the User row. Kept CURRENT rather than frozen at
  // creation by `syncOrganizationIdentity` (lib/organization.ts), which the profile
  // and branding write paths call.
  //
  // No reader yet: it was added for hub rendering, and hub branding is read from the
  // owner's User today. Kept true so a consumer can rely on it, and droppable if none
  // ever arrives — a frozen copy is only a stale copy.
  branding          Json?

  // Disclosures review status — powers the dashboard's "Disclosures not
  // reviewed" alert (shown to Owner/Admin/Editor while unreviewed). Set true
  // when the advisor completes the "Confirm Your Disclosures" attestation during
  // onboarding, or confirms from Settings > Disclosures.
  disclosuresReviewed   Boolean   @default(false)
  disclosuresReviewedAt DateTime?
  // The current disclosure revision number for this organization (see
  // `DisclosureVersion`). 0 means no revision has been recorded yet.
  disclosuresCurrentVersion Int  @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerUserId])
}

// A recorded confirmation that an organization's disclosures were reviewed.
//
// One row per confirmation, so the audit trail is preserved: who confirmed,
// for which organization, when, against which disclosure-template version and
// which attestation-copy version, and from where (onboarding / settings /
// plan). `Organization.disclosuresReviewed` is the fast-read mirror that drives
// the dashboard alert; this table is the history behind it.
model DisclosureAttestation {
  id                 String   @id @default(cuid())
  organizationId     String
  userId             String
  // Where the confirmation happened: "onboarding" | "settings" | "plan".
  context            String
  // Plan the confirmation relates to, for the "plan" context.
  planId             String?
  // Version of the default disclosure templates in effect (config).
  disclosureVersion  Int
  // Version of the attestation copy in effect (config).
  attestationVersion Int
  createdAt          DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
}

// An immutable snapshot of an organization's disclosures at one revision.
//
// Every committed disclosure save writes a NEW row — versions are never
// overwritten, so the revision tied to previously published content is always
// preserved. A save also clears `Organization.disclosuresReviewed` until the
// new revision is attested (Rule: an edit requires re-attestation).
model DisclosureVersion {
  id              String   @id @default(cuid())
  organizationId  String
  // Monotonic per organization, starting at 1.
  version         Int
  // Snapshot of the disclosures (array of Disclaimer objects).
  disclosures     Json
  // Version of the default disclosure templates in effect (config).
  templateVersion Int
  createdByUserId String
  // Where the change came from: "onboarding" | "settings" | "plan".
  context         String
  planId          String?
  createdAt       DateTime @default(now())

  @@unique([organizationId, version])
  @@index([organizationId])
}

// Partner Company (spec T1 Part B item 2): name, logo, branding.
// Entity type is always Partner/Provider — these must never appear in Plan
// Sponsor pickers (enforced in app/api/companies/search/route.ts).
// One company has many profiles.
model TeammateCompany {
  id             String                    @id @default(cuid())
  organizationId String
  name           String
  logo           String?
  branding       Json?
  entityType     TeammateCompanyEntityType @default(partner_provider)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
}

// Person Profile (spec T1 Part B item 1): who the person and their company are.
// Created once, reused across plans. Carries identity and company only — never
// plan-scoped data (documents, plan ids, group numbers, provider URLs,
// meetings, marketing assets, plan-specific messaging).
model TeammateProfile {
  id             String               @id @default(cuid())
  organizationId String
  // Global login link. One login can back profiles in several organizations;
  // each organization keeps its own profile (spec T1 Part B item 5).
  loginUserId    String?
  type           TeammatePersonType
  state          TeammateProfileState @default(contact)
  // The role the seat joins with, stored on the PROFILE so it survives having no assignment
  // yet — an invite raised before any plan exists. Assignment roles still win when they exist
  // (`mostPrivilegedRole` summarises those); this is the fallback the roster reads when there
  // is nothing to summarise, so an invited Viewer is never mislabelled by the `contributor`
  // assignment default.
  role           TeammateAssignmentRole?

  firstName         String?
  lastName          String?
  jobTitle          String?
  designations      String[]          @default([])
  email             String
  phone             String?
  phoneExtension    String?
  headshot          String?
  benefitsSpecialty String[]          @default([])

  // Card-only fields — the "Show on contact card" toggles and the call-to-action
  // group.
  //
  // These have no historical home on the teammate layer: they live on
  // `Client.keyContacts` (the authoring surface) and on `Benefit.supportContacts[]`
  // (the per-benefit override), and the portal contact cards read them from the
  // rebuilt `keyContacts` (see `hub-contacts.server.ts`). Copying them onto the seat
  // is what lets an invited teammate configure their OWN card at acceptance instead
  // of waiting for an admin, and `buildHubContacts` reads them back onto the card.
  //
  // `cardContactType` is deliberately not `type`: `type` is the ACCESS concept
  // (team_member | collaborator), while this pair is the CARD presentation choice
  // (individual | team_support).
  cardContactType     String?
  // Tri-state: NULL means "never configured" and the portal keeps showing the
  // email/phone as it always has; TRUE/FALSE are the person's explicit choices.
  // A plain `false` default would hide every existing card's contact details.
  displayEmail        Boolean?
  displayPhone        Boolean?
  enableContactButton Boolean?
  // "schedule" | "call" | "email" | "contact", mirrored onto the card as the
  // legacy `contactButtonType` ("calendar" | "phone" | "email" | "url").
  ctaType             String?
  schedulingUrl       String?
  websiteUrl          String?
  contactFormTopics   Json?

  companyId String?

  // Team Members only: when set, an assignment is generated automatically for
  // every newly created plan (spec T1 Part B item 4).
  allPlans Boolean @default(false)

  invitedByUserId String?
  invitedAt       DateTime?
  // Spec T6: "Deactivate: all access to the organization ends; the profile is
  // kept." Set instead of deleting so the audit trail and any content the person
  // created stay attributable. Null means the profile is live.
  deactivatedAt   DateTime?

  // Set when the person deletes their OWN account (`DELETE /api/profile/delete`).
  //
  // The profile is deliberately KEPT and its seat stays counted: `getSeatUsage`
  // counts every `state: "active"` profile that is not deactivated, so a member
  // deleting their own login does not silently hand the organization back a seat
  // nobody chose to release. An Owner or Admin then confirms the deletion from the
  // seat card, which removes the profile and only then releases the seat.
  //
  // Distinct from `deactivatedAt`, which RELEASES the seat and leaves the login
  // linked. Null means the profile has not been self-deleted.
  selfDeletedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([companyId])
  @@index([loginUserId])
  @@index([organizationId, deactivatedAt])
}

// Assignment (spec T1 Part B item 3): which plan and categories a profile is
// connected to, with what role, and whether they show on the hub.
// Exactly one record per person per plan (enforced by the compound unique).
model PlanAssignment {
  id             String                @id @default(cuid())
  organizationId String
  profileId      String
  clientId       String

  categoryScope TeammateCategoryScope @default(all)
  categories    String[]              @default([])

  role TeammateAssignmentRole @default(contributor)
  // The full function-level grid (types/teammate.ts → TeammatePermissionSet).
  // Presets write their default grid here; Custom writes the edited grid. Never
  // a reference to a preset, so changing a preset later cannot alter a Custom
  // user (spec T2a Part B item 5).
  permissionSet Json

  showOnBenefitsHub Boolean @default(true)

  // T7: the `KeyContact.id` this assignment was mirrored from.
  //
  // The hub renders from profile + assignment, but `Benefit.supportContacts[].contactId`
  // already references the id the advisor's contact carried when the benefit was saved.
  // Keeping that id ON the assignment is what lets a mirrored contact reproduce the same
  // card id, so every existing cross-reference keeps resolving without a rewrite.
  // Null for anyone who was never a Key Contact (a teammate added from Settings).
  contactId String?

  invitedByUserId     String?
  invitedAt           DateTime?
  // T4: the invite's own metadata, captured where it was raised (Create Benefits).
  // The card and the invite email both read these, so the note and the deadline the
  // advisor set are visible on both sides of the invite.
  inviteNote          String?
  inviteDueDate       DateTime?
  lastChangedByUserId String?
  lastChangedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, clientId])
  @@index([organizationId])
  @@index([clientId])
  @@index([profileId])
  // The mirror reconciles by (plan, contactId): which assignments came from contacts.
  @@index([clientId, contactId])
}

// Audit trail for teammate mutations. Backs T2a ("log who set Custom access,
// when, and which warnings were confirmed") and T6 ("every change is logged").
model TeammateAuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  profileId      String?
  assignmentId   String?
  actorUserId    String
  action         String
  // Custom-role saves record the soft warnings the user confirmed (spec T2a).
  warningsConfirmed Json?
  details           Json?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([profileId])
  @@index([assignmentId])
}
