// New Client Wizard Step 4: Compliance Documents
model NewClientComplianceDocuments {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String @unique @db.ObjectId

  spdFile                Json? // SPD document object
  retirementPlanDocuments Json? // Array of retirement plan documents (from DocumentsUploadSection)
  otherDocuments         Json? // Array of other document objects (from MultiFileUpload)
  recordkeeper           String? // Recordkeeper name for retirement services

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session NewClientWizardSession @relation(fields: [sessionId], references: [id])
}

// New Client Wizard Step 5: Employee Portal Preview
model NewClientEmployeePortalPreview {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String @unique @db.ObjectId

  previewData Json // Complete preview data for the employee portal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session NewClientWizardSession @relation(fields: [sessionId], references: [id])
}

// Client model - stores completed client data
model Client {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  // Additive tenancy anchor for the Team & Collaborator Access feature. `userId`
  // (the owning advisor) stays authoritative for existing queries; new code
  // scopes by organizationId through lib/organization.ts.
  organizationId String? @db.ObjectId

  // URL-friendly identifier (e.g. "acme-corp").
  //
  // Deliberately NOT @unique. On MongoDB a unique index counts every null as a
  // real key, so as soon as a second plan has no slug the build fails with
  // `dup key: { slug: null }` and aborts the entire `prisma db push`. Global slug
  // uniqueness is guaranteed by `PortalSlug.slug` (@unique, non-null), which
  // registers every current AND retired slug; this column is the legacy mirror,
  // and is additionally guarded by a partial unique index applied via
  // scripts/repair/apply-partial-unique-indexes.ts.
  slug   String?

  // Company Information
  companyName     String
  // Name-change tracking for the dashboard activity feed. `null` until the plan is
  // renamed; `updatedAt` cannot serve this purpose because every edit touches it.
  previousName    String?
  nameUpdatedAt   DateTime?
  companyWebsite  String?
  companyLogo     String? // Base64 or URL
  companyLogoCropData Json? // Crop metadata incl. originalImage for re-editing in modal
  logoFileName    String?
  brandColor      String  @default("#1F3A60")
  secondaryColor  String  @default("#6B7280")
  // Portal typography theme: "classic" | "modern" | "editorial" | "contemporary"
  // (see lib/typography-themes.ts). Null/unknown resolves to "classic", so
  // existing plans render the default theme without a backfill.
  typographyTheme String?
  missionHeadline String?
  missionBody     String?
  appointmentLink String?
  
  // Benefits / Employee Portal Data
  employeePortalPreview Json? // Stores benefits title, description, and other portal settings
  categoryPortalVisibility Json? // { Retirement: true, Group Life: true, Group Health: true, Other: true } - Show/Hide per category in portal only

  heroTitle       String? // Hero title for portal header
  heroDescription String? // Hero description for portal header
  heroOverlayOpacity              Float? // Overlay opacity (0-1)
  heroBackgroundOpacity           Float? // Background image opacity (0-1)
  heroContainerOpacity            Float? // Container (text box) opacity (0-1) - DEPRECATED: use heroContainerBackgroundOpacity and heroContainerBlockOpacity
  heroContainerBackgroundOpacity  Float? // Container background opacity (0-1)
  heroContainerBlockOpacity       Float? // Container block opacity (0-1)
  heroCompanyNameColor            String? // Company name color: "yellow" or "default"
  heroContainerInverted           Boolean? @default(false) // Invert container colors (white container with dark text)
  heroBackgroundInverted          Boolean? @default(false) // Invert background overlay colors (white overlay)
  heroUseGradient                 Boolean? @default(false) // Use gradient from top (transparent) to bottom (opaque)
  desktopHeroBackgroundPosition   Json? // { x: number, y: number } — desktop hero background focal point (percentage)
  mobileHeroBackgroundPosition    Json? // { x: number, y: number } — mobile hero background focal point (percentage)

  // Brand Images
  backgroundImg          String? // Base64 or URL (header/hero image)
  backgroundImgName      String?
  thumbnailImg           String? // Base64 or URL (square thumbnail)
  thumbnailImgName       String?
  secondaryBannerImg     String? // Base64 or URL (secondary banner)
  secondaryBannerImgName String?
  faviconImg             String? // Base64 or URL (favicon/icon)
  faviconImgName         String?

  brandImagesCropData    Json?

  disclaimers Json? // DisclaimersData object: { disclaimers: [], byCategory: { Retirement?: Disclaimer, "Group Life"?: Disclaimer, "Group Health"?: Disclaimer, Other?: Disclaimer }, disclosuresText: string, useDefaultDisclosures: boolean } — each portal category can have its own footer disclaimer (see types/new-client-wizard.ts)

  // Key Contacts
  keyContacts Json // [{name, role, customRole, email, phone, headshot, headshotFileName, bio, displayEmail, displayPhone, contactButton, contactButtonType, contactUrl}]

  // Recordkeeper (for retirement services)
  recordkeeper String? // Recordkeeper name for retirement services

  // Documents are now stored in separate Document table

  // Status
  status String @default("Active") // Draft, Active, Archived

  // Type
  type String @default("client") // client, prospect

  // Wizard step tracking
  currentStep Int @default(1) // Current step in the wizard when saved as draft

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  documents Document[]
  webinars  Webinar[]
  videos    Video[]    // ✅ Videos belong to Client (Benefits Hub)
  meetings  Meeting[]
  marketingFlyers MarketingFlyer[]
  marketingAssets MarketingAsset[]

  @@index([companyName])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  benefits Benefit[]
}

// Benefit model — one row per (clientId, category)
model Benefit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  category    String   // "Retirement" | "Group Health" | "Group Life" | "Company / Plan Sponsor"

  // Core
  title            String
  shortDescription String?

  // Journey Section
  journeyHeader   String?
  journeySubtitle String?
  journeyBodyText String?

  // Plan Video (raw R2 key)
  planVideo         String?
  planVideoFileName String?

  // Branding
  partnerLogo     String?
  backgroundImage String?
  innerHeaderImage String?

  // Help Cards
  helpCards Json?

  // Insurance / Portal Materials
  insurancePlanId               String?
  insuranceLoginUrl             String?
  insuranceBackgroundImage      String?
  insuranceContainerBlockOpacity Float?

  // FAQs & Support Contacts
  faqs            Json?
  supportContacts Json?
  // Provider / recordkeeper that administers this benefit for this category
  // (e.g. Voya, Empower, UnitedHealthcare). See types/benefit.ts → ProviderContact.
  // Rendered beside the account-access block; the provider's logo is `partnerLogo`.
  providerContact Json?

  // Closing & Signature
  signatureMode           String?
  customClosing           String?
  customSignatureName     String?
  customSignatureCompany  String?
  customClosingBold             Boolean?
  customClosingItalic           Boolean?
  customSignatureNameBold       Boolean?
  customSignatureNameItalic     Boolean?
  customSignatureCompanyBold    Boolean?
  customSignatureCompanyItalic  Boolean?

  // Hero Overlay Settings (per-benefit, overrides client-level)
  heroBackgroundOpacity    Float?
  heroContainerBlockOpacity Float?
  heroContainerInverted     Boolean?
  heroBackgroundInverted    Boolean?
  heroUseGradient           Boolean?
  desktopHeroBackgroundPosition Json?
  mobileHeroBackgroundPosition  Json?

  // Visibility
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, category])
  @@index([clientId])
  @@index([category])
}

// Meeting model
model Meeting {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?  @db.ObjectId
  clientId     String?  @db.ObjectId // Plan (Client) — set for Benefits Hub plan-scoped meetings
  meeting      String // Meeting name/title
  meetingType  String // Open Enrollment, Client Meeting, Training, etc. (plan meetings: 4 hub types)
  client       String // Client name (denormalized; legacy meetings without clientId)
  date         DateTime // Meeting date
  time         String // Meeting time
  timezone     String? // Meeting timezone (IANA preferred for plan meetings)
  duration     String // Meeting duration
  format       String // Virtual, In-Person, Hybrid
  platform     String? // Platform for virtual meetings (Zoom, Teams, Google Meet, Phone)
  meetingLink  String? // Meeting URL/link
  maxAttendees Int? // Maximum number of attendees
  attendees    Int      @default(0) // Current number of attendees
  description  String? // Meeting description
  status       String   @default("Scheduled") // Scheduled, Completed, Cancelled

  // Address fields for In-Person meetings
  address String? // Meeting address
  city    String? // City
  state   String? // State
  zip     String? // ZIP code

  language              String? // Meeting language (English, Spanish)
  benefitsCategory      String? // Retirement, Group Health, Group Life, Other
  customBenefitsCategory String? // Custom benefits category when Other is selected

  // Plan / Benefits Hub (3b.1)
  hubLocation      String? // Single location: join link or physical address
  displayOnPortal  Boolean  @default(true)
  archived         Boolean  @default(false)
  registrationUrl  String?
  replayUrl        String?
  startAtUtc       DateTime? // Sort/compare instant; derived from date + time + timezone when possible

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?   @relation(fields: [userId], references: [id])
  clientRecord Client? @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([client])
  @@index([date])
  @@index([status])
  @@index([meetingType])
  @@index([archived])
  @@index([displayOnPortal])
  @@index([startAtUtc])
}

model MeetingCustomType {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  value       String
  label       String
  description String
  userId      String @db.ObjectId
  user        User   @relation(fields: [userId], references: [id])
}

// Webinar model for Webinars & Replays
model Webinar {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  clientId     String   @db.ObjectId // Reference to Client (Plan)
  clientName   String   // Client company name (denormalized for easier queries)
  webinarTitle String   // Webinar title
  description  String?  // Optional description shown alongside the replay
  thumbnail    String?  // Base64 data URL for the replay card image (uploaded or a captured video frame)
  // Benefit category the video belongs to: Retirement, Health, Life, Other or All.
  benefitsCategory String?
  // Portal pages this video is published on: an array of placement keys
  // ("news-events", "retirement", …). JSON rather than a scalar list so rows
  // saved before this field existed read as null and can fall back to the default.
  placements   Json?
  // Length of videoFileUrl. Stored so list queries can sort by size without
  // reading the multi-MB base64 payload (see the webinars list endpoint).
  videoSize    Int?
  eventDate    DateTime // Event date
  sourceType   Json     // { upload: boolean, url: boolean }
  videoFileUrl String?  // URL/path if uploaded file
  videoUrl     String?  // URL if external link (YouTube/Vimeo)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([eventDate])
  @@index([createdAt])
}

// Document model
model Document {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String // Document title
  fileName        String // Original file name
  fileUrl         String // Legacy: base64 data URL. When storageKey is set, may be empty; file is served from R2 via signed URL.
  storageKey      String?   // R2 object key (org/.../documents/{category}/...) when file is in R2
  type            String    @default("Document") // Document type: SPD, SBC, or Document
  shortDescription String? // Optional short description for the document
  language        String?  @default("EN") // Document language: EN or ES
  clientId        String    @db.ObjectId // Reference to Client
  category           String?  // Document category: Retirement, Group Health, etc. (BenefitsCategory / portal mapping)
  categorySuggested  String?  // AI- or auto-detected suggested category (spec: aiSuggestedCategory)
  categoryConfidence Int?      // 0–100 confidence for categorySuggested (spec: aiConfidence)
  uploadedAt         DateTime  @default(now())
  expirationDate     DateTime? // Optional expiration date for the document
  sortOrder          Int?      // Advisor-set display order; lower sorts first (nulls = last)
  showQrCode         Boolean   @default(true) // Whether to expose QR / quick-access affordances for this document
  archivedAt         DateTime? // Soft-archive: null = active; set = hidden from Hub default lists

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([uploadedAt])
  @@index([language])
  @@index([expirationDate])
  @@index([clientId, category])
  @@index([clientId, archivedAt])
}

// Plan-scoped marketing flyers (Benefits Hub QR + co-brand snapshot + R2 assets)
model MarketingFlyer {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String    @db.ObjectId
  userId          String    @db.ObjectId
  mode            String // hub_promo_general | action_beneficiaries | meetings_invite | ...
  modeOptions     Json? // { category?, openEnrollmentLabel?, meetingTitle?, ... }
  headline        String
  body            String
  cta             String
  hubUrlSnapshot  String // Absolute URL encoded in QR at generation time
  brandSnapshot   Json // sponsor + organization branding at render time
  pdfStorageKey   String
  pngStorageKey   String
  aiModel         String?
  aiPromptVersion String?
  generatedCopyAt DateTime?
  title           String? // Optional library title (defaults to headline in UI)
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([clientId, archivedAt])
  @@index([createdAt])
}

// Unified marketing assets (flyer, portal-notice, pop-up, news-post)
model MarketingAsset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String   @db.ObjectId
  userId    String   @db.ObjectId
  type      String   // "flyer" | "portal-notice" | "pop-up" | "news-post"
  status    String   @default("Draft") // Draft | Ready for Review | Published | Scheduled | Hidden | Archived
  headline  String
  body      String   @default("")
  ctaText   String   @default("")
  startDate String?
  endDate   String?
  bgColor   String   @default("#23919c")
  data      Json?    // Type-specific payload: { subtitle?, meetingTime?, noticeType?, showEveryVisit?, category?, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([clientId, type])
  @@index([clientId, status])
}

// Headshot model for processed user headshots
model Headshot {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId // Reference to User
  originalUrl String // Original image URL/base64
  square400   String // 400x400 square variant
  square800   String // 800x800 square variant (retina)
  circle400   String // 400x400 circle variant with transparent background
  circle800   String // 800x800 circle variant (retina)
  avatar64    String // 64x64 small avatar
  cropData    Json // Crop coordinates and settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// Global portal-slug registry.
//
// Holds a plan's CURRENT slug and every historical (retired) slug so old
// QR/printed/shared links keep resolving. `slug` is globally @unique across
// BOTH current and retired rows — that single constraint is what makes a
// retired slug permanently reserved (another advisor cannot claim it), which
// prevents old links from silently pointing at a different company.
//
// Renaming demotes the old row (isCurrent = false → it becomes an "alias") and
// inserts/promotes the new one. Aliases are never mutated or auto-deleted; a
// slug leaves the namespace only via an explicit release (row deleted).
model PortalSlug {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  slug       String    @unique
  clientId   String    @db.ObjectId
  isCurrent  Boolean   @default(true)
  // When the row was demoted to an alias (null while it is the current slug).
  retiredAt  DateTime?
  // The slug that replaced this one (traceability; null when current).
  replacedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId])
  @@index([clientId, isCurrent])
}

// ─────────────────────────────────────────────────────────────────────────────
// Team & Collaborator Access (spec: Team_Collaborator_Access_Developer_Spec)
//
// T1 introduces a real Organization entity. `userId` (the owning User) remains
// the anchor for every pre-existing query; `organizationId` is the forward
// looking anchor that all teammate reads and writes are scoped by. The two are
// kept in sync by scripts/teammates/backfill-organizations.ts and by the signup
// path in lib/auth-options.ts.
//
// Why plain scalar `organizationId` instead of an `@relation`: the MongoDB
// connector requires both sides of a relation to be declared and pulls in
// referential-action semantics we do not want for an additive migration. Every
// teammate collection is scoped by an explicit organizationId filter instead.
// ─────────────────────────────────────────────────────────────────────────────

// Organization — the tenancy root for the Team & Collaborator Access feature.
// One per advisor User today (ownerUserId), created at signup or by backfill.
model Organization {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  ownerUserId       String   @db.ObjectId
  organizationEmail String?
  // T3 seat metering. Both are placeholders until tier pricing is final (spec
  // Open Decisions): a null `seatsIncluded` falls back to DEFAULT_SEATS_INCLUDED,
  // and a confirmed over-limit add raises `seatsIncluded` by one rather than
  // hard-blocking.
  seatsIncluded     Int?
  planTier          String?
  // Owner branding mirrored at creation time so teammate hub rendering has a
  // stable org-level source even if the owner later rebrands.
  branding          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerUserId])
}

// Partner Company (spec T1 Part B item 2): name, logo, branding.
// Entity type is always Partner/Provider — these must never appear in Plan
// Sponsor pickers (enforced in app/api/companies/search/route.ts).
// One company has many profiles.
model TeammateCompany {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                    @db.ObjectId
  name           String
  logo           String?
  branding       Json?
  entityType     TeammateCompanyEntityType @default(partner_provider)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
}

// Person Profile (spec T1 Part B item 1): who the person and their company are.
// Created once, reused across plans. Carries identity and company only — never
// plan-scoped data (documents, plan ids, group numbers, provider URLs,
// meetings, marketing assets, plan-specific messaging).
model TeammateProfile {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String               @db.ObjectId
  // Global login link. One login can back profiles in several organizations;
  // each organization keeps its own profile (spec T1 Part B item 5).
  loginUserId    String?              @db.ObjectId
  type           TeammatePersonType
  state          TeammateProfileState @default(contact)

  firstName         String?
  lastName          String?
  jobTitle          String?
  designations      String[]          @default([])
  email             String
  phone             String?
  phoneExtension    String?
  headshot          String?
  benefitsSpecialty String[]          @default([])

  companyId String? @db.ObjectId

  // Team Members only: when set, an assignment is generated automatically for
  // every newly created plan (spec T1 Part B item 4).
  allPlans Boolean @default(false)

  invitedByUserId String?   @db.ObjectId
  invitedAt       DateTime?
  // Spec T6: "Deactivate: all access to the organization ends; the profile is
  // kept." Set instead of deleting so the audit trail and any content the person
  // created stay attributable. Null means the profile is live.
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([companyId])
  @@index([loginUserId])
  @@index([organizationId, deactivatedAt])
}

// Assignment (spec T1 Part B item 3): which plan and categories a profile is
// connected to, with what role, and whether they show on the hub.
// Exactly one record per person per plan (enforced by the compound unique).
model PlanAssignment {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                @db.ObjectId
  profileId      String                @db.ObjectId
  clientId       String                @db.ObjectId

  categoryScope TeammateCategoryScope @default(all)
  categories    String[]              @default([])

  role TeammateAssignmentRole @default(contributor)
  // The full function-level grid (types/teammate.ts → TeammatePermissionSet).
  // Presets write their default grid here; Custom writes the edited grid. Never
  // a reference to a preset, so changing a preset later cannot alter a Custom
  // user (spec T2a Part B item 5).
  permissionSet Json

  showOnBenefitsHub Boolean @default(true)

  invitedByUserId     String?   @db.ObjectId
  invitedAt           DateTime?
  // T4: the invite's own metadata, captured where it was raised (Create Benefits).
  // The card and the invite email both read these, so the note and the deadline the
  // advisor set are visible on both sides of the invite.
  inviteNote          String?
  inviteDueDate       DateTime?
  lastChangedByUserId String?   @db.ObjectId
  lastChangedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, clientId])
  @@index([organizationId])
  @@index([clientId])
  @@index([profileId])
}

// Audit trail for teammate mutations. Backs T2a ("log who set Custom access,
// when, and which warnings were confirmed") and T6 ("every change is logged").
model TeammateAuditEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  profileId      String?  @db.ObjectId
  assignmentId   String?  @db.ObjectId
  actorUserId    String   @db.ObjectId
  action         String
  // Custom-role saves record the soft warnings the user confirmed (spec T2a).
  warningsConfirmed Json?
  details           Json?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([profileId])
  @@index([assignmentId])
}
